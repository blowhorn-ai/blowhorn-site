{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "blowhorn-signups",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-12",
  "d1_databases": [
    {
      "binding": "SIGNUPS_DB",
      "database_name": "blowhorn-signups",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "routes": [
    {
      "pattern": "api.blowhorn.ai",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "preview_urls": false,
  "workers_dev": false,
  "vars": {
    "SUPPORT_FORWARD_URL": "https://cloud.layer5.io/api/marketing/forms/blowhorn-support"
  }
}

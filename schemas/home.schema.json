{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blowhorn.ai/schemas/home.schema.json",
  "title": "Home page",
  "description": "data/home.json: copy and art for the Signal home page, rendered by layouts/_partials/home/signal.html and layouts/_partials/home/app-mock.html. Sections in page order: hero, ticker, How it works, AI, Trust, social proof, closing. Plain text, hyphens never em dashes. Links are site paths; the layout resolves them with site.GetPage (or prefixes relURL for a folder path) and fails the build when a page is missing. Images are assets/ paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["hero", "ticker", "mock", "how", "ai", "trust", "proof", "closing"],
  "definitions": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1 }
      }
    },
    "art": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt", "width", "height"],
      "properties": {
        "src": { "type": "string", "pattern": "^assets/brand/.+\\.webp$" },
        "alt": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "hero": {
      "description": "One fixed h1 (no rotation), one line under it, one install call (download-button.html) and one text link. The Major sits beside the copy.",
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "subhead", "secondary", "major"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "subhead": { "type": "string", "minLength": 1 },
        "secondary": { "$ref": "#/definitions/link" },
        "major": {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "alt", "width", "height"],
          "properties": {
            "src": { "type": "string", "pattern": "^assets/brand/mascot/.+\\.webp$" },
            "alt": { "type": "string", "minLength": 1 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "ticker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": { "label": { "type": "string", "minLength": 1 } }
    },
    "mock": {
      "description": "The hero product mock, drawn from the real app shell. Rail items are the app's places (Dashboard, Activity, Profiles, Performance, Posture); there is no Home item. Rows name a platform id from data/integrations.json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ariaLabel", "rail", "active", "account", "title", "search", "shortcut", "newActivity", "rows"],
      "properties": {
        "ariaLabel": { "type": "string", "minLength": 1 },
        "rail": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "string", "enum": ["Dashboard", "Activity", "Profiles", "Performance", "Posture"] }
        },
        "active": { "type": "string", "enum": ["Dashboard", "Activity", "Profiles", "Performance", "Posture"] },
        "account": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "search": { "type": "string", "minLength": 1 },
        "shortcut": { "type": "string", "minLength": 1 },
        "newActivity": { "type": "string", "enum": ["New activity"] },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "title", "sub", "time", "status"],
            "properties": {
              "platform": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "sub": { "type": "string", "minLength": 1 },
              "time": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "how": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "headline", "feature", "stat", "mockup"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "headline": { "type": "string", "minLength": 1 },
        "feature": {
          "description": "Feature + art, span 7. One character (Sleeper Cell on schedule).",
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "body", "art"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 },
            "art": { "$ref": "#/definitions/art" }
          }
        },
        "stat": {
          "description": "Stat, span 5. The numeral is the count of supported platforms in data/integrations.json, never typed in.",
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "link", "actions"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "link": { "$ref": "#/definitions/link" },
            "actions": { "$ref": "#/definitions/link" }
          }
        },
        "mockup": {
          "description": "Mockup, span 12: a menu bar popover mock with figures and on/off switches.",
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "body", "figures", "toggles"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 },
            "figures": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "label"],
                "properties": {
                  "value": { "type": "string", "pattern": "^[0-9]+$" },
                  "label": { "type": "string", "minLength": 1 }
                }
              }
            },
            "toggles": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "headline", "subhead", "links", "code", "art"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "headline": { "type": "string", "minLength": 1 },
        "subhead": { "type": "string", "minLength": 1 },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/link" }
        },
        "code": {
          "description": "A terminal code card: one command (copyable) and one result line under it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "command", "result"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "command": { "type": "string", "minLength": 1 },
            "result": { "type": "string", "minLength": 1 }
          }
        },
        "art": { "$ref": "#/definitions/art" }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "headline", "art", "points"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "headline": { "type": "string", "minLength": 1 },
        "art": { "$ref": "#/definitions/art" },
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body", "link"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "body": { "type": "string", "minLength": 1 },
              "link": { "$ref": "#/definitions/link" }
            }
          }
        }
      }
    },
    "proof": {
      "description": "Social proof, shown once. Quotes come from data/testimonials.json entries placed home-feature (Quote L) and home-quote (two Quote S, in file order).",
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": { "label": { "type": "string", "minLength": 1 } }
    },
    "closing": {
      "description": "The closing section (id #download): one install call (download-button.html) and one text link.",
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "secondary"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "secondary": { "$ref": "#/definitions/link" }
      }
    }
  }
}
